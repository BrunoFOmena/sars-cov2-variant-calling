// SARS-CoV-2 variant calling pipeline configuration

params {
    // Input / reference
    reads        = "${projectDir}/data/raw/*/*_{1,2}.fastq.gz"
    reference    = "${projectDir}/data/reference/NC_045512.2.fasta"
    snpeff_db    = "NC_045512.2"
    outdir       = "${projectDir}/results"

    // Thresholds (documented in the README)
    min_depth    = 10     // positions below this depth are masked (N) in the consensus
    min_af       = 0.05   // minimum allele frequency to report a variant
    consensus_af = 0.50   // minimum allele frequency to apply a variant to the consensus
    min_qual     = 30     // minimum variant QUAL
}

process {
    cpus   = 2
    memory = '2 GB'
    withName: 'BWA_MEM' { cpus = 6 }
    withName: 'FASTP'   { cpus = 4 }
}

profiles {
    // Default: run with the tools already on PATH (activate the conda env first)
    local {
        process.executor = 'local'
    }
    // Let Nextflow create the environment from environment.yml
    conda {
        conda.enabled   = true
        process.conda   = "${projectDir}/environment.yml"
    }
}

manifest {
    name        = 'sars2-variant-calling'
    description = 'Paired-end SARS-CoV-2 variant calling pipeline'
    mainScript  = 'main.nf'
    nextflowVersion = '>=25.04'
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
